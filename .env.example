# ==========================================
# Dubai AI Travel Planning System - Config
# ==========================================

# Active LLM Provider Configuration
# Supported providers: google, groq, openai, ollama
LLM_PROVIDER=google
LLM_MODEL_NAME=gemini-2.5-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ==========================================
# Primary API Keys (Provide Google or Groq)
# ==========================================
# Google Gemini API Key (e.g. from Google AI Studio: https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here

# Groq API Key (e.g. from Groq Console: https://console.groq.com/keys)
# When LLM_PROVIDER=groq, recommended model is: llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# Optional: Generic LLM API Key (used if GOOGLE_API_KEY / GROQ_API_KEY not set)
LLM_API_KEY=

# Fallback LLM Provider (Optional)
FALLBACK_LLM_PROVIDER=
FALLBACK_LLM_MODEL=
FALLBACK_LLM_API_KEY=

# Feature Flags (100% Free Stack)
ENABLE_WEATHER_INTEGRATION=true
ENABLE_OSRM_ROUTING=true
ENABLE_HUMAN_IN_THE_LOOP=false

# Execution Limits & Storage
MAX_REVIEW_ITERATIONS=3
MAX_TOKENS_PER_RUN=50000
API_CACHE_TTL_HOURS=168
SQLITE_DB_PATH=data/database/dubai_travel.db
